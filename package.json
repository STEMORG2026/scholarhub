{
  "name": "scholarhub",
  "version": "0.44.0",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "check:links": "node scripts/validate-catalog.mjs --links",
    "check:protection": "node scripts/check-branch-protection.mjs",
    "lint": "eslint .",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm run lint && npm run test:cov && node scripts/validate-catalog.mjs && node scripts/validate-requirements.mjs && node scripts/render-smoke.mjs",
    "test:cov": "node --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-include='scripts/**' --test-coverage-include='data/**' --test-coverage-lines=92 --test-coverage-branches=82 --test-coverage-functions=92",
    "test:render": "node scripts/render-smoke.mjs",
    "validate": "node scripts/validate-catalog.mjs && node scripts/validate-requirements.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0"
  }
}
